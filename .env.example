# ---------- Server ----------
PORT=5050
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ---------- MongoDB (npm run db:up starts an Atlas-compatible local instance) ----------
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB_NAME=advanced_rag
# auto | atlas | local   (local = exact in-process cosine scan, works on a plain mongod)
VECTOR_BACKEND=auto
VECTOR_INDEX_NAME=chunk_embedding_index
VECTOR_NUM_CANDIDATES=200

# ======================================================================
# Models. Free options, no paid Anthropic plan needed.
#
# Option A (default): Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
#   (no card). Chat, vision and embeddings all use this one key. Free tier has rate limits and
#   Google may use free-tier prompts to improve its products, so do not send confidential PDFs.
#
# Option B: Ollama, fully local, no key, no limits, nothing leaves the machine.
#   LLM_PROVIDER=ollama
#   EMBEDDING_PROVIDER=ollama
#   Setup is in the README ("Fully local with Ollama").
#
# Option C: Anthropic / Voyage if you later get keys: LLM_PROVIDER=anthropic, EMBEDDING_PROVIDER=voyage
# ======================================================================
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=

# Every value below defaults from the provider; set only to override.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_ANSWER_MODEL=gemini-3.8-flash
# LLM_VISION_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (503), rate limited (429) or retired (404)
# LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# LLM_CONTEXT_BUDGET_TOKENS=24000     # 6000 by default for ollama
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768            # must equal the vector index size; changing it needs a reprocess
# EMBEDDING_BATCH_SIZE=32
LLM_MAX_TOKENS=1500
# Seconds to wait for a response (non-streamed calls) and between streamed chunks, then the next fallback model is tried
LLM_TIMEOUT_MS=120000
LLM_IDLE_TIMEOUT_MS=60000
# Gemini 3 models always think; low keeps answers fast. Values: minimal, low, medium, high. Leave empty to omit.
# LLM_REASONING_EFFORT=low
# USD per million tokens, for the cost tracker only. Free tiers leave these at 0.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0
EMBEDDING_PRICE_PER_MTOK=0

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=20
# Use 4 or 5 with small local models
FINAL_CONTEXT_CHUNKS=8
RRF_K=60
RERANK_PROVIDER=heuristic   # heuristic | llm (llm costs one extra call per question)

# ---------- Documents ----------
DOCUMENTS_DIR=../data/documents
UPLOAD_MAX_SIZE_MB=100
# Bump when extraction or chunking logic changes, then reprocess
PROCESSING_VERSION=1
MIN_PAGE_TEXT_CHARS=80
VISION_RENDER_SCALE=2
# Cap on vision calls per document (keeps you inside free-tier quotas)
VISION_MAX_PAGES=40
OCR_LANG=eng
